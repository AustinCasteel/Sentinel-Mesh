# ╔══════════════════════════════════════════════════════════════╗
# ║  SentinelMesh Environment Configuration                     ║
# ║  Copy to .env and fill in your values                       ║
# ╚══════════════════════════════════════════════════════════════╝

# ── LLM Provider Selection ──────────────────────────────────────
# Options: "openai", "ollama", "lemonade", "bedrock"
SENTINEL_LLM_PROVIDER=openai

# ── OpenAI / OpenAI-Compatible ──────────────────────────────────
SENTINEL_OPENAI_API_KEY=sk-...
SENTINEL_OPENAI_API_BASE=https://api.openai.com/v1
SENTINEL_OPENAI_MODEL=gpt-4o

# ── Ollama (Local) ──────────────────────────────────────────────
SENTINEL_OLLAMA_BASE_URL=http://localhost:11434
SENTINEL_OLLAMA_MODEL=llama3.1

# ── Lemonade (Local, hybrid CPU/GPU/NPU) ────────────────────────
# Lightweight alternative to Ollama with lower overhead and hybrid
# hardware execution.  See https://lemonade-server.ai
SENTINEL_LEMONADE_BASE_URL=http://localhost:13305
SENTINEL_LEMONADE_MODEL=llama-3.1-8b

# ── AWS Bedrock ─────────────────────────────────────────────────
SENTINEL_BEDROCK_REGION=us-east-1
SENTINEL_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS credentials via standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY

# ── Neo4j Knowledge Graph ──────────────────────────────────────
SENTINEL_NEO4J_URI=bolt://localhost:7687
SENTINEL_NEO4J_USER=neo4j
SENTINEL_NEO4J_PASSWORD=sentinel-mesh

# ── Qdrant Vector Store ────────────────────────────────────────
SENTINEL_QDRANT_HOST=localhost
SENTINEL_QDRANT_PORT=6333
SENTINEL_QDRANT_COLLECTION=threat_intel

# ── Langfuse Observability ─────────────────────────────────────
SENTINEL_LANGFUSE_PUBLIC_KEY=pk-...
SENTINEL_LANGFUSE_SECRET_KEY=sk-...
SENTINEL_LANGFUSE_HOST=http://localhost:3000

# ── OpenTelemetry ──────────────────────────────────────────────
SENTINEL_OTEL_EXPORTER_ENDPOINT=http://localhost:4317
SENTINEL_OTEL_SERVICE_NAME=sentinel-mesh

# ── Threat Intel APIs ──────────────────────────────────────────
# AbuseIPDB: Free tier (1,000 req/day). Register at https://www.abuseipdb.com
SENTINEL_ABUSEIPDB_API_KEY=
# ThreatFox (abuse.ch): Free auth key. Register at https://auth.abuse.ch
SENTINEL_THREATFOX_AUTH_KEY=

# ── MCP Server ─────────────────────────────────────────────────
SENTINEL_MCP_SERVER_COMMAND=python
SENTINEL_MCP_SERVER_ARGS=mcp_servers/threat_intel_server.py

# ── Agent Tuning ───────────────────────────────────────────────
SENTINEL_MAX_RETRIES=3
SENTINEL_MAX_ITERATIONS=10
